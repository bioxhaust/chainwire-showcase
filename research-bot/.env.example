# Configuration inventory: every supported variable has an EMPTY, COMMENTED value.
# Keep unused entries commented to preserve the code defaults (numeric blanks fail).
# Copying this file does not activate offline mode. Read README.md before running.
# Never put real credentials, channel identifiers or private endpoints in this file.

# Credentials (uncomment and populate only in a local, ignored .env when authorized)
# OPENAI_API_KEY=
# TELEGRAM_BOT_TOKEN=
# X_BEARER_TOKEN=
# ROOTDATA_API_KEY=
# CRYPTORANK_API_KEY=

# Destinations and external services
# CHANNEL_ID=
# CHANNEL_RU=
# CHANNEL_EN=
# LLM_BASE_URL=
# LLM_MODEL=
# PUBLISHER=
# TG_NEWS_CHANNELS=

# Runtime paths (docs/ops/runtime-data.md). RB_ENV=test|staging requires RB_DATA_DIR (a copy of
# research-bot/data); RB_DB alone outside data/ is refused as false isolation unless RB_ENV is set.
# RB_ENV=
# RB_DATA_DIR=
# RB_DB=
# RB_KB_DB=
# RB_CORPUS=

# Numeric settings: populate a valid number before uncommenting
# POST_MIN_SCORE=
# LOOP_MINUTES=
# HOT_SCAN_HOURS=
# HOT_MIN_SCORE=
# HOT_MAX_POSTS=
# HOT_MAX_CANDIDATES=
# HOT_MIN_MENTIONS=
# HOT_DEADLINE_DAYS=
# BREAKING_MIN_SOURCES=
# BREAKING_COOLDOWN_H=
# BREAKING_MAX_AGE_H=
# NEWS_MIN_IMPORTANCE=
# NEWS_MAX_POSTS=

# Boolean setting: use false explicitly to disable channel announcements
# ANNOUNCE_IN_CHANNEL=
